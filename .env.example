PORT=8080

# Swiss Ephemeris data files (task A3).
# Point either variable at a directory containing `.se1` files for full Swiss
# precision (SWEPH_PATH takes precedence over EPHE_PATH). When neither is set
# or the directory is missing, the service falls back to the built-in Moshier
# ephemeris (no data files; Chiron/asteroids unavailable). See README.
# SWEPH_PATH=/app/ephe
# EPHE_PATH=

# AI PDF reports (task A8 / F1). Required ONLY for the POST /report endpoint; the
# astrology endpoints work without them. These are SERVER-SIDE secrets and must
# never be shipped to the device (NEVER put any of these in an EXPO_PUBLIC_* var).
#
# Provider selection (default = Google Gemini; Anthropic kept as a one-env-var
# revert):
#   AI_PROVIDER                 — `gemini` (default) or `anthropic`.
#   GEMINI_API_KEY              — Google Generative Language API key (default
#                                 provider). The Generative Language API must be
#                                 enabled on the Google Cloud project / the key
#                                 unblocked, or calls 403 (API_KEY_SERVICE_BLOCKED).
#   GEMINI_MODEL                — optional model id override (default
#                                 `gemini-2.5-pro` for reports).
#   ANTHROPIC_API_KEY           — Anthropic Messages API key (used only when
#                                 AI_PROVIDER=anthropic).
#   SUPABASE_URL                — your project URL.
#   SUPABASE_SERVICE_ROLE_KEY   — service role key: verifies the caller's JWT,
#                                 checks premium, loads the chart, uploads the
#                                 PDF to the private `reports` bucket.
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=
# ANTHROPIC_API_KEY=
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
